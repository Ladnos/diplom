// Схема базы auth_db — принадлежит только сервису auth-service.
// Database per Service: обращаться к этим таблицам из других сервисов
// запрещено, данные отдаются через gRPC и события (docs/architecture.md §1).

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
//  Учётные записи
// ─────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  /// scrypt: соль и параметры внутри строки, см. password.service.ts
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  /// Заполняется, когда hr-service создаст профиль по событию
  /// auth.user.registered. До этого момента у пользователя нет сотрудника,
  /// и все проверки со scope, кроме GLOBAL, для него не проходят.
  employeeId   String?    @unique @map("employee_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles    UserRole[]
  sessions Session[]

  @@map("users")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Хранится ХЭШ, а не сам refresh-токен: утечка дампа базы не должна
  /// давать возможность войти под пользователем.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────
//  RBAC со scope (ADR-3, часть 2)
//
//  Право — это не «роль руководителя», а пара «роль + область действия».
//  Руководитель утверждает заявки не вообще, а только своих подчинённых.
// ─────────────────────────────────────────────────────────────────────────

enum PermissionScope {
  /// Только собственные объекты
  SELF
  /// Объекты прямых и косвенных подчинённых
  SUBORDINATE
  /// Объекты своего отдела
  DEPARTMENT
  /// Без ограничений
  GLOBAL
}

model Role {
  code String @id
  name String

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId   String @map("user_id") @db.Uuid
  roleCode String @map("role_code")

  /// Роль выдана системой, а не человеком.
  ///
  /// MANAGER выводится из оргструктуры: появился первый подчинённый —
  /// появилась роль, не осталось ни одного — снялась. Синхронизация
  /// трогает ТОЛЬКО записи с auto = true, поэтому роль, выданную
  /// администратором вручную, она никогда не снимет.
  auto       Boolean  @default(false)
  /// userId администратора. null для авто-выдачи и для bootstrap.
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Cascade)

  @@id([userId, roleCode])
  @@index([roleCode])
  @@map("user_roles")
}

model RolePermission {
  id       String          @id @default(uuid()) @db.Uuid
  roleCode String          @map("role_code")
  resource String
  action   String
  scope    PermissionScope

  role Role @relation(fields: [roleCode], references: [code], onDelete: Cascade)

  @@unique([roleCode, resource, action])
  @@index([resource, action])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────
//  Денормализованная копия оргструктуры
//
//  Чтобы ответить «руководитель ли X для Y», auth-service держит
//  собственную проекцию, наполняемую событиями hr.employee.* и
//  hr.hierarchy.changed. Синхронный вызов в hr-service на КАЖДУЮ проверку
//  прав сделал бы hr узким местом всей системы и связал бы вход в систему
//  с доступностью кадрового сервиса.
// ─────────────────────────────────────────────────────────────────────────

model EmployeeRef {
  employeeId   String   @id @map("employee_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  managerId    String?  @map("manager_id") @db.Uuid
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([managerId])
  @@index([departmentId])
  @@index([userId])
  @@map("employee_refs")
}

/// Транзитивное замыкание дерева подчинения.
/// Проверка «X руководитель Y» — один индексный поиск вместо рекурсивного
/// обхода иерархии на каждый запрос.
model ManagerSubordinate {
  managerId     String @map("manager_id") @db.Uuid
  subordinateId String @map("subordinate_id") @db.Uuid
  /// 1 — прямой подчинённый, 2 — подчинённый подчинённого и так далее
  depth         Int

  @@id([managerId, subordinateId])
  @@index([subordinateId])
  @@map("manager_subordinates")
}

/// Делегирование права согласования на время отсутствия руководителя.
/// Наполняется событием approval.delegation.set.
model ApprovalDelegation {
  id         String   @id @default(uuid()) @db.Uuid
  managerId  String   @map("manager_id") @db.Uuid
  delegateId String   @map("delegate_id") @db.Uuid
  validFrom  DateTime @map("valid_from")
  validTo    DateTime @map("valid_to")

  @@index([delegateId, validFrom, validTo])
  @@map("approval_delegations")
}

// ─────────────────────────────────────────────────────────────────────────
//  Инфраструктура обмена сообщениями (§7.7)
// ─────────────────────────────────────────────────────────────────────────

/// Транзакционный outbox: событие пишется в ОДНОЙ транзакции с изменением
/// доменных данных, публикует его OutboxWorker.
model Outbox {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @unique @map("event_id") @db.Uuid
  eventType       String    @map("event_type")
  eventVersion    Int       @default(1) @map("event_version")
  payload         Json
  correlationId   String    @map("correlation_id")
  causationId     String?   @map("causation_id")
  actorUserId     String?   @map("actor_user_id")
  actorEmployeeId String?   @map("actor_employee_id")
  occurredAt      DateTime  @map("occurred_at")
  sentAt          DateTime? @map("sent_at")
  attempts        Int       @default(0)
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([sentAt, createdAt])
  @@map("outbox")
}

/// Идемпотентность потребителя: RabbitMQ гарантирует at-least-once,
/// составной первичный ключ отбрасывает повтор на уровне БД.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumer])
  @@index([processedAt])
  @@map("processed_events")
}
