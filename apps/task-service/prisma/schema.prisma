// Схема базы task_db — принадлежит только сервису task-service.
// Kanban: доски, колонки, карточки. docs/architecture.md §2.1

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
//  Доски
// ─────────────────────────────────────────────────────────────────────────

model Board {
  id   String @id @default(uuid()) @db.Uuid
  name String

  /// Доска отдела. Сотрудники этого отдела получают доступ автоматически
  /// по событию hr.employee.created; доска без отдела — проектная,
  /// участники добавляются вручную.
  departmentId String? @map("department_id") @db.Uuid

  createdByEmployeeId String  @map("created_by_employee_id") @db.Uuid
  archived            Boolean @default(false)

  columns Column[]
  cards   Card[]
  labels  Label[]
  members BoardMember[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([departmentId])
  @@map("boards")
}

enum BoardRole {
  /// Может всё, включая удаление доски и правку колонок
  OWNER
  /// Работает с карточками
  MEMBER
  /// Только чтение
  VIEWER
}

model BoardMember {
  boardId String @map("board_id") @db.Uuid
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  employeeId String    @map("employee_id") @db.Uuid
  role       BoardRole @default(MEMBER)

  addedAt DateTime @default(now()) @map("added_at")

  @@id([boardId, employeeId])
  @@index([employeeId])
  @@map("board_members")
}

model Column {
  id String @id @default(uuid()) @db.Uuid

  boardId String @map("board_id") @db.Uuid
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  name     String
  position Float

  /// Предел числа карточек в колонке. 0 — без ограничения.
  ///
  /// Смысл Kanban именно в этом ограничении: оно делает перегрузку
  /// видимой и заставляет доводить начатое до конца, вместо того чтобы
  /// набирать новое.
  wipLimit Int @default(0) @map("wip_limit")

  /// Колонка завершения: попадание карточки сюда закрывает её и даёт
  /// точку отсчёта для расчёта времени выполнения.
  isDoneColumn Boolean @default(false) @map("is_done_column")

  cards Card[]

  createdAt DateTime @default(now()) @map("created_at")

  // Уникальности по (boardId, position) намеренно НЕТ: позиции дробные,
  // и при перестановке колонок промежуточное состояние может совпасть.
  // Порядок задаётся сортировкой, а не ограничением.
  @@index([boardId, position])
  @@map("columns")
}

// ─────────────────────────────────────────────────────────────────────────
//  Карточки
// ─────────────────────────────────────────────────────────────────────────

model Card {
  id String @id @default(uuid()) @db.Uuid

  boardId String @map("board_id") @db.Uuid
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  columnId String @map("column_id") @db.Uuid
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  title       String
  description String?

  authorEmployeeId   String  @map("author_employee_id") @db.Uuid
  assigneeEmployeeId String? @map("assignee_employee_id") @db.Uuid

  /// Дробная позиция внутри колонки.
  ///
  /// Вставка между соседями — среднее их позиций, без перенумерации
  /// остальных карточек. При исчерпании точности (соседи слишком близко)
  /// колонка перебалансируется — см. position.util.ts.
  position Float

  /// Оптимистическая блокировка. Двое перетащили одну карточку
  /// одновременно — второй получит конфликт вместо молчаливой перезаписи.
  version Int @default(1)

  dueDate         DateTime? @map("due_date") @db.Date
  estimateMinutes Int       @default(0) @map("estimate_minutes")

  /// Метаданные вложений из file-service. Сами файлы здесь не хранятся.
  attachmentFileIds String[] @default([]) @map("attachment_file_ids")

  closedAt DateTime? @map("closed_at")

  labels   CardLabel[]
  comments Comment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([boardId, columnId, position])
  @@index([assigneeEmployeeId, closedAt])
  @@index([dueDate])
  @@map("cards")
}

model Label {
  id String @id @default(uuid()) @db.Uuid

  boardId String @map("board_id") @db.Uuid
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  name  String
  color String @default("#6b7280")

  cards CardLabel[]

  @@unique([boardId, name])
  @@map("labels")
}

model CardLabel {
  cardId  String @map("card_id") @db.Uuid
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String @map("label_id") @db.Uuid
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@map("card_labels")
}

model Comment {
  id String @id @default(uuid()) @db.Uuid

  cardId String @map("card_id") @db.Uuid
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  authorEmployeeId String   @map("author_employee_id") @db.Uuid
  body             String
  /// Упомянутые сотрудники — им уходит уведомление независимо от того,
  /// следят ли они за карточкой.
  mentions         String[] @default([])

  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")

  @@index([cardId, createdAt])
  @@map("comments")
}

/// Проекция доступности исполнителей.
///
/// Наполняется событиями hr.absence.registered и hr.employee.deactivated.
/// Нужна, чтобы доска показывала «исполнитель в отпуске до 14 сентября»
/// без обращения к кадровому сервису на каждую отрисовку — а заодно
/// чтобы не назначать задачу тому, кого не будет две недели.
model EmployeeAvailability {
  employeeId String @id @map("employee_id") @db.Uuid

  active      Boolean   @default(true)
  absentUntil DateTime? @map("absent_until") @db.Date
  absenceType String?   @map("absence_type")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employee_availability")
}

// ─────────────────────────────────────────────────────────────────────────
//  Инфраструктура обмена сообщениями (§7.7)
// ─────────────────────────────────────────────────────────────────────────

model Outbox {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @unique @map("event_id") @db.Uuid
  eventType       String    @map("event_type")
  eventVersion    Int       @default(1) @map("event_version")
  payload         Json
  correlationId   String    @map("correlation_id")
  causationId     String?   @map("causation_id")
  actorUserId     String?   @map("actor_user_id")
  actorEmployeeId String?   @map("actor_employee_id")
  occurredAt      DateTime  @map("occurred_at")
  sentAt          DateTime? @map("sent_at")
  attempts        Int       @default(0)
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([sentAt, createdAt])
  @@map("outbox")
}

model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumer])
  @@index([processedAt])
  @@map("processed_events")
}
