// Схема базы video_db — принадлежит только сервису video-service.
// Database per Service: обращаться к этим таблицам из других сервисов
// запрещено, данные отдаются через gRPC и события (docs/architecture.md §1).

generator client {
  provider      = "prisma-client-js"
  // Свой каталог на сервис: клиенты девяти сервисов не должны
  // перезаписывать друг друга в общем node_modules монорепозитория.
  output        = "../generated/prisma"
  // musl-вариант нужен для рантайма на node:22-alpine
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Комната звонка.
///
/// В базе — только то, что переживает сам звонок: кто, когда, откуда и
/// сколько длилось. Живое состояние — транспорты, потоки, кто сейчас
/// говорит — держит SFU в памяти и Redis: писать в PostgreSQL на каждое
/// включение микрофона бессмысленно, а после перезапуска это состояние
/// всё равно недействительно.
model Room {
  id                  String     @id @default(uuid()) @db.Uuid
  title               String
  initiatorEmployeeId String     @map("initiator_employee_id") @db.Uuid
  /// Канал чата, из которого начат звонок. По нему chat-service положит
  /// в переписку системную запись о завершении (§8.3).
  channelId           String?    @map("channel_id") @db.Uuid
  cardId              String?    @map("card_id") @db.Uuid
  status              RoomStatus @default(CREATED)
  recording           Boolean    @default(false)
  startedAt           DateTime   @default(now()) @map("started_at")
  endedAt             DateTime?  @map("ended_at")

  participants        Participant[]

  /// Выборка активных комнат сотрудника — самый частый запрос интерфейса.
  @@index([status, startedAt])
  @@index([channelId])
  @@map("rooms")
}

enum RoomStatus {
  /// Комната заведена, но никто ещё не вошёл.
  CREATED
  ACTIVE
  ENDED

  @@map("room_status")
}

/// Участие в звонке.
///
/// Строка заводится на приглашение, а не на вход: приглашённый должен
/// увидеть звонок в интерфейсе до того, как к нему присоединится.
/// Отсюда joinedAt, допускающий null, — «позван, но не пришёл».
model Participant {
  roomId      String    @map("room_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  isModerator Boolean   @default(false) @map("is_moderator")
  /// Последние известные состояния устройств. Обновляются сигналингом и
  /// нужны, чтобы вошедший позже увидел, у кого выключен микрофон, не
  /// дожидаясь следующего изменения.
  audioEnabled Boolean  @default(true) @map("audio_enabled")
  videoEnabled Boolean  @default(true) @map("video_enabled")
  joinedAt    DateTime? @map("joined_at")
  leftAt      DateTime? @map("left_at")

  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, employeeId])
  @@index([employeeId, leftAt])
  @@map("participants")
}

/// Проекция кадровых данных (§6.3).
///
/// Нужны имя для списка участников и признак увольнения, чтобы не звать
/// в звонок того, кто уже не работает. Ходить за этим в hr-service при
/// каждом создании комнаты нельзя: звонок начинают тогда, когда он нужен
/// сейчас, а не когда кадровый сервис ответит.
model EmployeeRef {
  employeeId String   @id @map("employee_id") @db.Uuid
  fullName   String   @map("full_name")
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("employee_refs")
}

/// Транзакционный outbox (§7.7).
/// Событие пишется сюда в ОДНОЙ транзакции с изменением доменных данных,
/// а публикует его отдельный воркер. Без этого падение процесса между
/// COMMIT и publish() теряет событие безвозвратно.
model Outbox {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  eventType     String    @map("event_type")
  eventVersion  Int       @default(1) @map("event_version")
  payload       Json
  correlationId String    @map("correlation_id")
  causationId   String?   @map("causation_id")
  actorUserId   String?   @map("actor_user_id")
  actorEmployeeId String? @map("actor_employee_id")
  occurredAt    DateTime  @map("occurred_at")
  sentAt        DateTime? @map("sent_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Частичный индекс по неотправленным — воркер читает только их
  @@index([sentAt, createdAt])
  @@map("outbox")
}

/// Идемпотентность потребителя (§7.7).
/// RabbitMQ гарантирует at-least-once, поэтому одно и то же событие может
/// прийти дважды. Составной первичный ключ отбрасывает повтор на уровне БД.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumer])
  @@index([processedAt])
  @@map("processed_events")
}
