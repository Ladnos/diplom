// Схема базы hr_db — принадлежит только сервису hr-service.
// Мастер-данные о персонале: сотрудники, оргструктура, типы найма.
// docs/architecture.md §2.1, §3, ADR-1

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
//  Модель найма (§3)
//
//  ДВЕ ОРТОГОНАЛЬНЫЕ характеристики, а не один плоский enum: правовая
//  форма и форма оплаты комбинируются. Плоский перечислимый тип порождал
//  бы LABOR_SALARY, LABOR_HOURLY, LABOR_PIECEWORK… и рос мультипликативно.
// ─────────────────────────────────────────────────────────────────────────

/// Правовая форма отношений
enum EmploymentType {
  LABOR_CONTRACT
  CIVIL_CONTRACT
  SELF_EMPLOYED
  ENTREPRENEUR
  OUTSTAFF
  INTERN
}

/// Форма оплаты
enum PaymentForm {
  SALARY
  HOURLY
  PIECEWORK
  PER_ACT
}

/// Производная от пары (EmploymentType, PaymentForm).
/// ЕДИНСТВЕННАЯ величина, по которой ветвится код (§3.2): добавление
/// нового типа найма — строка в таблице соответствия, без правок
/// в табеле, согласованиях и отчётности.
enum TimeTrackingPolicy {
  NORM_BASED
  FACT_BASED
  DELIVERABLE_BASED
  NONE
}

// ─────────────────────────────────────────────────────────────────────────
//  Оргструктура
// ─────────────────────────────────────────────────────────────────────────

model Department {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  parentId String? @map("parent_id") @db.Uuid

  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentTree")

  employees Employee[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([parentId])
  @@map("departments")
}

model Position {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  employees Employee[]

  @@map("positions")
}

model Employee {
  id String @id @default(uuid()) @db.Uuid

  /// Учётная запись в auth-service. Заполняется при создании профиля
  /// по событию auth.user.registered.
  userId   String  @unique @map("user_id") @db.Uuid
  fullName String  @map("full_name")
  /// Контактные данные — мастер-копия здесь, notification-service держит
  /// собственную проекцию, наполняемую событиями hr.employee.* (§7.5).
  email    String  @unique
  phone    String?

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  positionId String?   @map("position_id") @db.Uuid
  position   Position? @relation(fields: [positionId], references: [id])

  managerId String?    @map("manager_id") @db.Uuid
  manager   Employee?  @relation("Hierarchy", fields: [managerId], references: [id])
  reports   Employee[] @relation("Hierarchy")

  active       Boolean   @default(true)
  avatarFileId String?   @map("avatar_file_id") @db.Uuid
  hiredAt      DateTime? @map("hired_at") @db.Date
  firedAt      DateTime? @map("fired_at") @db.Date

  contracts   EmploymentContract[]
  shifts      Shift[]
  absences    Absence[]
  adjustments TimesheetAdjustment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([managerId])
  @@index([active])
  @@map("employees")
}

/// Отдельный агрегат, а не поля сотрудника: история найма должна
/// сохраняться для корректного расчёта прошлых периодов при переводе
/// ГПХ → штат и обратно (§10.5).
model EmploymentContract {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        EmploymentType
  paymentForm PaymentForm        @map("payment_form")
  /// Вычисляется из (type, paymentForm) и хранится денормализованно:
  /// по нему фильтруют выборки, а пересчитывать правило в каждом запросе
  /// значит не иметь возможности проиндексировать его.
  policy      TimeTrackingPolicy
  /// Ставка: 1.0, 0.5, 0.25. Совместительство — это rate, а не отдельный
  /// тип найма (§3.1).
  rate        Decimal            @default(1.0) @db.Decimal(4, 2)

  validFrom DateTime  @map("valid_from") @db.Date
  /// null — бессрочный
  validTo   DateTime? @map("valid_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@index([employeeId, validFrom])
  @@map("employment_contracts")
}

// ─────────────────────────────────────────────────────────────────────────
//  Модуль schedule: графики, смены, отсутствия
//
//  Границы модулей внутри hr-service (ADR-1) проходят и здесь: staff не
//  обращается к этим таблицам напрямую, только через доменные сервисы.
// ─────────────────────────────────────────────────────────────────────────

enum ScheduleTemplateKind {
  /// Фиксированные дни недели: 5/2, 6/1. Праздники — выходные.
  FIXED_WEEK
  /// Цикл смен: 2/2, 1/3. Работает и в праздники.
  SHIFT_CYCLE
}

model ScheduleTemplate {
  id   String               @id @default(uuid()) @db.Uuid
  name String
  kind ScheduleTemplateKind

  /// FIXED_WEEK: рабочие дни недели, 1 = понедельник … 7 = воскресенье
  weekdays Int[] @default([])

  /// SHIFT_CYCLE: длина цикла в днях и номера рабочих дней внутри цикла.
  /// Для 2/2 это cycleLength = 4, cycleWorkDays = [1, 2].
  cycleLength   Int?  @map("cycle_length")
  cycleWorkDays Int[] @default([]) @map("cycle_work_days")
  /// Дата, от которой отсчитывается цикл
  cycleAnchor   DateTime? @map("cycle_anchor") @db.Date

  startTime    String  @map("start_time") // HH:MM
  endTime      String  @map("end_time")   // HH:MM
  breakMinutes Int     @default(60) @map("break_minutes")
  active       Boolean @default(true)

  shifts    Shift[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("schedule_templates")
}

model Shift {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date         DateTime @db.Date
  startsAt     String   @map("starts_at") // HH:MM
  endsAt       String   @map("ends_at")
  breakMinutes Int      @default(60) @map("break_minutes")

  templateId String?           @map("template_id") @db.Uuid
  template   ScheduleTemplate? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  /// Одна смена на сотрудника в день: две смены подряд — это переработка,
  /// оформляемая отдельно, а не вторая запись графика.
  @@unique([employeeId, date])
  @@index([date])
  @@map("shifts")
}

enum AbsenceType {
  VACATION
  SICK_LEAVE
  TIME_OFF
  BUSINESS_TRIP
  UNPAID
}

model Absence {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type     AbsenceType
  dateFrom DateTime    @map("date_from") @db.Date
  dateTo   DateTime    @map("date_to") @db.Date

  /// Заявка из approval-service, породившая отсутствие. Пусто, если
  /// оформлено кадровиком напрямую (приказом), минуя согласование.
  requestId String? @unique @map("request_id") @db.Uuid
  comment   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([employeeId, dateFrom, dateTo])
  @@map("absences")
}

enum CalendarDayKind {
  /// Нерабочий праздничный день
  HOLIDAY
  /// Предпраздничный: рабочий день сокращается на час (ст. 95 ТК РФ)
  SHORTENED
  /// Перенесённый рабочий день — суббота или воскресенье стали рабочими
  WORKDAY
}

/// Производственный календарь.
///
/// Хранятся только ИСКЛЮЧЕНИЯ: обычные будни и выходные выводятся из дня
/// недели. Полный календарь на год — это ~250 строк ни о чём, тогда как
/// исключений в году около двадцати.
model CalendarDay {
  date DateTime        @id @db.Date
  kind CalendarDayKind
  note String?

  @@map("calendar_days")
}

// ─────────────────────────────────────────────────────────────────────────
//  Модуль timesheet: табель
//
//  Записи табеля НЕ хранятся — они вычисляются (ADR-2):
//      отработано = норма по графику − отсутствия + переработки
//  Хранятся только слагаемые, которых нет в графике и отсутствиях:
//  согласованные переработки и ручные корректировки.
// ─────────────────────────────────────────────────────────────────────────

enum AdjustmentKind {
  /// Добавляется к норме дня
  OVERTIME
  /// Задаёт итог за день целиком, перекрывая расчёт
  CORRECTION
}

model TimesheetAdjustment {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date    DateTime       @db.Date
  kind    AdjustmentKind
  minutes Int

  /// Согласованная заявка — штатный источник переработки (ADR-2).
  /// Пусто, если оформлено кадровиком приказом.
  requestId String? @unique @map("request_id") @db.Uuid
  reason    String?
  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([employeeId, date])
  @@map("timesheet_adjustments")
}

/// Закрытый период табеля.
///
/// После закрытия расчёт за период фиксируется: правки требуют повторного
/// открытия, что оставляет след. Без этого задним числом меняется уже
/// сданная в бухгалтерию отчётность.
model TimesheetPeriod {
  id String @id @default(uuid()) @db.Uuid

  departmentId String? @map("department_id") @db.Uuid

  /// Ключ области: идентификатор отдела либо литерал 'ALL'.
  ///
  /// Нужен вместо nullable departmentId в уникальном индексе: PostgreSQL
  /// считает NULL не равным другому NULL, поэтому ограничение по
  /// (department_id, period_from, period_to) НЕ помешало бы закрыть один
  /// и тот же общесистемный период дважды.
  scopeKey String @map("scope_key")

  periodFrom DateTime @map("period_from") @db.Date
  periodTo   DateTime @map("period_to") @db.Date

  closed   Boolean   @default(false)
  closedBy String?   @map("closed_by") @db.Uuid
  closedAt DateTime? @map("closed_at")

  /// Итог на момент закрытия — снимок, а не пересчёт: график задним
  /// числом мог измениться, а сданный табель меняться не должен.
  totalMinutes Int @default(0) @map("total_minutes")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([scopeKey, periodFrom, periodTo])
  @@index([periodFrom, periodTo])
  @@map("timesheet_periods")
}

// ─────────────────────────────────────────────────────────────────────────
//  Инфраструктура обмена сообщениями (§7.7)
// ─────────────────────────────────────────────────────────────────────────

model Outbox {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @unique @map("event_id") @db.Uuid
  eventType       String    @map("event_type")
  eventVersion    Int       @default(1) @map("event_version")
  payload         Json
  correlationId   String    @map("correlation_id")
  causationId     String?   @map("causation_id")
  actorUserId     String?   @map("actor_user_id")
  actorEmployeeId String?   @map("actor_employee_id")
  occurredAt      DateTime  @map("occurred_at")
  sentAt          DateTime? @map("sent_at")
  attempts        Int       @default(0)
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([sentAt, createdAt])
  @@map("outbox")
}

model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumer])
  @@index([processedAt])
  @@map("processed_events")
}
