// Схема базы hr_db — принадлежит только сервису hr-service.
// Мастер-данные о персонале: сотрудники, оргструктура, типы найма.
// docs/architecture.md §2.1, §3, ADR-1

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
//  Модель найма (§3)
//
//  ДВЕ ОРТОГОНАЛЬНЫЕ характеристики, а не один плоский enum: правовая
//  форма и форма оплаты комбинируются. Плоский перечислимый тип порождал
//  бы LABOR_SALARY, LABOR_HOURLY, LABOR_PIECEWORK… и рос мультипликативно.
// ─────────────────────────────────────────────────────────────────────────

/// Правовая форма отношений
enum EmploymentType {
  LABOR_CONTRACT
  CIVIL_CONTRACT
  SELF_EMPLOYED
  ENTREPRENEUR
  OUTSTAFF
  INTERN
}

/// Форма оплаты
enum PaymentForm {
  SALARY
  HOURLY
  PIECEWORK
  PER_ACT
}

/// Производная от пары (EmploymentType, PaymentForm).
/// ЕДИНСТВЕННАЯ величина, по которой ветвится код (§3.2): добавление
/// нового типа найма — строка в таблице соответствия, без правок
/// в табеле, согласованиях и отчётности.
enum TimeTrackingPolicy {
  NORM_BASED
  FACT_BASED
  DELIVERABLE_BASED
  NONE
}

// ─────────────────────────────────────────────────────────────────────────
//  Оргструктура
// ─────────────────────────────────────────────────────────────────────────

model Department {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  parentId String? @map("parent_id") @db.Uuid

  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentTree")

  employees Employee[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([parentId])
  @@map("departments")
}

model Position {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  employees Employee[]

  @@map("positions")
}

model Employee {
  id String @id @default(uuid()) @db.Uuid

  /// Учётная запись в auth-service. Заполняется при создании профиля
  /// по событию auth.user.registered.
  userId   String  @unique @map("user_id") @db.Uuid
  fullName String  @map("full_name")
  /// Контактные данные — мастер-копия здесь, notification-service держит
  /// собственную проекцию, наполняемую событиями hr.employee.* (§7.5).
  email    String  @unique
  phone    String?

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  positionId String?   @map("position_id") @db.Uuid
  position   Position? @relation(fields: [positionId], references: [id])

  managerId String?    @map("manager_id") @db.Uuid
  manager   Employee?  @relation("Hierarchy", fields: [managerId], references: [id])
  reports   Employee[] @relation("Hierarchy")

  active       Boolean   @default(true)
  avatarFileId String?   @map("avatar_file_id") @db.Uuid
  hiredAt      DateTime? @map("hired_at") @db.Date
  firedAt      DateTime? @map("fired_at") @db.Date

  contracts EmploymentContract[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([managerId])
  @@index([active])
  @@map("employees")
}

/// Отдельный агрегат, а не поля сотрудника: история найма должна
/// сохраняться для корректного расчёта прошлых периодов при переводе
/// ГПХ → штат и обратно (§10.5).
model EmploymentContract {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        EmploymentType
  paymentForm PaymentForm        @map("payment_form")
  /// Вычисляется из (type, paymentForm) и хранится денормализованно:
  /// по нему фильтруют выборки, а пересчитывать правило в каждом запросе
  /// значит не иметь возможности проиндексировать его.
  policy      TimeTrackingPolicy
  /// Ставка: 1.0, 0.5, 0.25. Совместительство — это rate, а не отдельный
  /// тип найма (§3.1).
  rate        Decimal            @default(1.0) @db.Decimal(4, 2)

  validFrom DateTime  @map("valid_from") @db.Date
  /// null — бессрочный
  validTo   DateTime? @map("valid_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@index([employeeId, validFrom])
  @@map("employment_contracts")
}

// ─────────────────────────────────────────────────────────────────────────
//  Инфраструктура обмена сообщениями (§7.7)
// ─────────────────────────────────────────────────────────────────────────

model Outbox {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @unique @map("event_id") @db.Uuid
  eventType       String    @map("event_type")
  eventVersion    Int       @default(1) @map("event_version")
  payload         Json
  correlationId   String    @map("correlation_id")
  causationId     String?   @map("causation_id")
  actorUserId     String?   @map("actor_user_id")
  actorEmployeeId String?   @map("actor_employee_id")
  occurredAt      DateTime  @map("occurred_at")
  sentAt          DateTime? @map("sent_at")
  attempts        Int       @default(0)
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([sentAt, createdAt])
  @@map("outbox")
}

model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumer])
  @@index([processedAt])
  @@map("processed_events")
}
