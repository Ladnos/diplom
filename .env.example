# ============================================================================
# CRM — пример конфигурации. Скопируйте в .env и поменяйте секреты.
#   cp .env.example .env
# ============================================================================

NODE_ENV=development
LOG_LEVEL=debug
TZ=Europe/Moscow

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Один инстанс, отдельная база и роль на каждый сервис (Database per Service).
# Базы и роли создаются автоматически: docker/postgres/init/01-init-databases.sh
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=crm
POSTGRES_SUPERUSER_PASSWORD=change_me_postgres
# Общий пароль сервисных ролей (в проде задайте отдельный на каждую роль)
POSTGRES_SERVICE_PASSWORD=change_me_service

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=crm
RABBITMQ_PASSWORD=change_me_rabbit
RABBITMQ_VHOST=/

# ── JWT (auth-service) ──────────────────────────────────────────────────────
# Сгенерировать: openssl rand -hex 48
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Первый администратор ────────────────────────────────────────────────────
# Учётка создаётся при старте auth-service, ТОЛЬКО если в системе ещё нет
# ни одного администратора. Если пользователь с таким email уже
# зарегистрирован — ему просто выдаётся роль ADMIN.
#
# Пароль можно не задавать: он будет сгенерирован и один раз напечатан
# в логе auth-service (docker compose logs auth-service). Это надёжнее
# значения по умолчанию, которое остаётся в установке навсегда.
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME="Администратор системы"

# ── Файловое хранилище (ADR-4: локальная ФС, без S3) ────────────────────────
FILE_STORAGE_PATH=/data/files
# Предел на один файл. client_max_body_size в nginx задан отдельно (50m):
# при увеличении этого значения не забыть и его, иначе nginx отвергнет
# запрос раньше, чем сервис успеет объяснить причину.
FILE_MAX_UPLOAD_BYTES=52428800
# Секрет подписи ссылок. Подставляется И в file-service, И в конфигурацию
# nginx (docker/nginx/nginx.conf.template) — там он тоже читается из этой
# переменной, поэтому расходиться им негде. Не короче 16 символов: сервис
# откажется стартовать, потому что подпись, которую можно воспроизвести,
# подписью не является.
FILE_SIGNED_LINK_SECRET=change_me_link_secret
FILE_SIGNED_LINK_TTL=86400
FILE_QUOTA_PER_USER_BYTES=5368709120
FILE_DISK_ALERT_THRESHOLD=0.85
# Сколько дней файл без единой привязки ждёт, прежде чем его уберёт
# сборщик мусора. Отсрочка покрывает разрыв между «прикрепил файл» и
# «отправил сообщение».
FILE_GC_GRACE_DAYS=7

# ── Уведомления ─────────────────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CRM <noreply@example.local>"
# Web Push: npx web-push generate-vapid-keys
# Пара ключей ПОСТОЯННА для установки: сгенерированная заново делает
# недействительными все существующие подписки браузеров, и push молча
# перестаёт приходить. Пустые значения просто отключают канал.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.local
# Абсолютный адрес интерфейса: ссылку из письма открывают в почтовом
# клиенте, где относительный путь никуда не ведёт.
PUBLIC_BASE_URL=http://localhost:8080

# ── Видеозвонки (WebRTC) ────────────────────────────────────────────────────
# Публичный IP или DNS-имя сервера — клиенты идут к SFU напрямую,
# поэтому здесь не может быть внутреннего адреса Docker-сети.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
TURN_HOST=127.0.0.1
TURN_PORT=3478
TURN_REALM=crm.local
TURN_USER=crm
TURN_PASSWORD=change_me_turn

# ── Публичные адреса ────────────────────────────────────────────────────────
PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_PORT=8443
PUBLIC_URL=http://localhost:8080

# ── gRPC-адреса сервисов (внутренняя сеть Docker) ───────────────────────────
AUTH_SERVICE_URL=auth-service:50051
HR_SERVICE_URL=hr-service:50052
APPROVAL_SERVICE_URL=approval-service:50053
TASK_SERVICE_URL=task-service:50054
CHAT_SERVICE_URL=chat-service:50055
VIDEO_SERVICE_URL=video-service:50056
FILE_SERVICE_URL=file-service:50057
NOTIFICATION_SERVICE_URL=notification-service:50058
ANALYTICS_SERVICE_URL=analytics-service:50059
# ATTENDANCE_SERVICE_URL=attendance-service:50060  # зарезервирован, §3.4
