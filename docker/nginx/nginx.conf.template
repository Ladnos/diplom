worker_processes auto;

events {
    worker_connections 4096;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # sendfile(2) — ключевая настройка для локального файлового хранилища:
    # именно она позволяет отдавать файл напрямую из ядра, не пропуская
    # байты через Node (docs/architecture.md §9.3, ADR-4).
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    server_tokens   off;

    log_format json escape=json '{'
        '"time":"$time_iso8601",'
        '"remote_addr":"$remote_addr",'
        '"method":"$request_method",'
        '"uri":"$uri",'
        '"status":$status,'
        '"bytes":$body_bytes_sent,'
        '"duration":$request_time,'
        '"correlation_id":"$http_x_correlation_id",'
        '"upstream":"$upstream_addr"'
    '}';
    access_log /dev/stdout json;
    error_log  /dev/stderr warn;

    gzip on;
    gzip_types application/json application/javascript text/css text/plain;
    gzip_min_length 1024;

    # Встроенный DNS Docker. valid=10s — адреса перечитываются, а не
    # кэшируются навсегда: контейнер после docker compose up получает
    # НОВЫЙ IP, а nginx с upstream-блоком резолвит имя один раз при
    # старте и после пересоздания сервиса отдаёт 502 на живое приложение.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Защита от перебора пароля на входе
    limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=api:10m rate=100r/s;

    server {
        listen 80;
        server_name _;

        # Перенаправления — ОТНОСИТЕЛЬНЫЕ.
        #
        # nginx по умолчанию отвечает на «/login» перенаправлением на
        # абсолютный «http://localhost/login/» — он видит себя на порту 80
        # и ничего не знает о том, что снаружи опубликован 8080. Клиент
        # уходит на несуществующий адрес, и выглядит это как отказ
        # соединения, а не как ошибка конфигурации.
        #
        # Перенаправления здесь возникают сами: у собранного интерфейса
        # каждая страница лежит каталогом (login/index.html), и try_files
        # находит её по «$uri/».
        absolute_redirect off;

        # proxy_pass с переменной — единственный способ заставить nginx
        # резолвить имя на каждом запросе (см. resolver выше)
        set $api_gateway     http://api-gateway:3000;
        set $file_service    http://file-service:3008;
        set $video_signaling http://video-service:3006;

        client_max_body_size 50m;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ── Загрузка файлов идёт МИМО api-gateway ────────────────────────
        # Многомегабайтные тела не должны проходить через сервис, который
        # обслуживает все остальные запросы (§9.2).
        location /api/files/upload {
            proxy_pass $file_service;
            proxy_request_buffering off;   # потоковая передача, без буфера на диск
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            client_max_body_size 50m;
        }

        # ── Приватные файлы: X-Accel-Redirect ────────────────────────────
        # file-service проверяет права и возвращает пустое тело с заголовком
        # X-Accel-Redirect; отдачу перехватывает nginx (§9.3).
        location /api/files/ {
            proxy_pass $file_service;
        }

        # Внутренний location, куда указывает X-Accel-Redirect.
        # internal — снаружи недоступен, обратиться можно только изнутри.
        location /internal-files/ {
            internal;
            alias /data/files/objects/;
            add_header Cache-Control "private, max-age=3600";
        }

        # ── Полупубличные файлы: подписанная ссылка ──────────────────────
        # Аватары и превью: подпись проверяет сам nginx, приложение не
        # вызывается вообще (§9.4).
        #
        # ${FILE_SIGNED_LINK_SECRET} подставляется при старте контейнера из
        # переменной окружения — той же самой, по которой file-service
        # подписывает ссылки. Держать здесь литерал значило бы либо хранить
        # секрет в репозитории, либо однажды разойтись с сервисом, и тогда
        # все ссылки разом начали бы отдавать 403 без единой ошибки в логах
        # приложения.
        # Префикс /media/, а не /files/: последний нужен самому приложению
        # как адрес раздела «Файлы». Локация перехватывала бы его раньше
        # SPA-маршрута и отдавала 403 — подписи-то в обычном переходе нет.
        # Внутренний путь доставки не должен занимать пользовательский
        # адрес: у первого имя произвольно, у второго — нет.
        location /media/ {
            secure_link $arg_sig,$arg_expires;
            secure_link_md5 "$secure_link_expires$uri$remote_addr ${FILE_SIGNED_LINK_SECRET}";

            if ($secure_link = "")  { return 403; }   # подпись неверна
            if ($secure_link = "0") { return 410; }   # срок истёк

            alias /data/files/objects/;
            expires 7d;
            add_header Cache-Control "public, immutable";
        }

        # ── WebSocket-сигналинг видеозвонков ─────────────────────────────
        # Прямое соединение с video-service, минуя gateway: сигналинг
        # stateful и чувствителен к задержке (§8.3).
        location /signaling {
            proxy_pass $video_signaling;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # ── WebSocket клиента: Kanban, чат, уведомления ──────────────────
        location /ws {
            proxy_pass $api_gateway;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location /api/auth/login {
            limit_req zone=login burst=3 nodelay;
            proxy_pass $api_gateway;
        }

        location /api/ {
            limit_req zone=api burst=200 nodelay;
            proxy_pass $api_gateway;
        }

        # Health самого nginx — не проксируется
        location = /healthz {
            access_log off;
            return 200 "ok\n";
        }

        # SPA: раздача статики и history-fallback.
        # Каталог появится, когда будет собран фронтенд.
        location / {
            root /usr/share/nginx/html;
            try_files $uri $uri/ /index.html;
        }
    }
}
