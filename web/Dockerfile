# syntax=docker/dockerfile:1
# ════════════════════════════════════════════════════════════════════════════
#  web — интерфейс на Nuxt, собирается в статику
#
#  Контекст сборки — каталог web/, а не корень репозитория: фронтенд НЕ
#  входит в npm-workspaces монорепозитория. Его дерево зависимостей
#  (Vue, Vite, Tailwind) не нужно ни одному сервису, а `npm ci` в образе
#  каждого из девяти тянул бы его целиком.
#
#  Результат — статические файлы, которые раздаёт nginx. Отдельного
#  контейнера с Node для этого не нужно: SSR выключен (см. nuxt.config.ts).
# ════════════════════════════════════════════════════════════════════════════

FROM node:22-alpine AS builder

WORKDIR /app

# npm той же основной версии, что и на машине разработчика.
#
# node:22-alpine несёт npm 10, а lock-файл написан одиннадцатым. Разница
# не в формате (обе версии пишут lockfileVersion 3), а в трактовке
# необязательных платформенных зависимостей: у oxc-parser их полтора
# десятка под разные архитектуры, и npm 10 не находит в чужом lock-файле
# записи, которую ждёт. `npm ci` при этом отказывается ставить вообще
# что-либо — и это правильно: молча разойтись с зафиксированными
# версиями хуже, чем упасть.
RUN npm install -g npm@11

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build

# ── Рантайм ────────────────────────────────────────────────────────────────
#
# Образ существует не ради процесса, а ради содержимого: он копирует
# собранные файлы в общий с nginx том и завершается. Держать ради статики
# ещё один работающий контейнер незачем.
FROM alpine:3

RUN apk add --no-cache rsync

COPY --from=builder /app/.output/public /srv/web

# rsync с --delete, а не cp: при обновлении из тома должны исчезнуть файлы
# предыдущей сборки. Хэши в именах меняются, и без удаления том за
# несколько развёртываний накапливает все старые версии бандла.
CMD ["sh", "-c", "rsync -a --delete /srv/web/ /usr/share/nginx/html/ && echo 'интерфейс разложен в том'"]
